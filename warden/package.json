{
	"name": "@drupflare/warden",
	"version": "1.0.0",
	"type": "module",
	"description": "The CLI for bastion, the manager of a bastion",
	"license": "MIT",
	"types": "./src/index.ts",
	"bin": {
		"bastion": "./dist/cli.js",
		"warden": "./dist/cli.js"
	},
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"warden": "bun src/cli.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"build:dist": "bun build src/cli.ts --target=node --outdir dist --format=esm --packages=external",
		"build:binary": "bun build --compile --minify --outfile dist/bastion src/cli.ts",
		"prepublishOnly": "bun run build:dist",
		"docs:cli": "bun scripts/docs-cli.ts"
	},
	"dependencies": {
		"@drupflare/bastion": "workspace:*",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"author": "Gregory Mitchell <me@gmitch215.xyz>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drupflare/bastion.git",
		"directory": "warden"
	},
	"keywords": [
		"workerd",
		"cli",
		"self-hosted",
		"drupflare"
	]
}

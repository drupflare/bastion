{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["core/src/index.ts"],
	"tsconfig": "core/tsconfig.json",
	"out": "build-typedoc",
	"name": "bastion",
	"readme": "./README.md",
	"favicon": "assets/favicon.png",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": false
	},
	"treatWarningsAsErrors": false
}
